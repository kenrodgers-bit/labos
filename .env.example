# Root reference only. Prefer copying server/.env.example to server/.env
# and client/.env.example to client/.env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/labos
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
# LabOS fix: use a facility-specific seed password instead of publishing a working demo password.
LABOS_SEED_PASSWORD=replace-with-temporary-demo-password
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
